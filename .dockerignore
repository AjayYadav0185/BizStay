# Git / VCS
.git
.gitattributes
.gitignore

# Local dependencies (installed inside the image at build time)
node_modules
vendor

# Flutter app — not part of the web deployment (points at the API over HTTPS)
bizstay_app
.dart_tool
build

# Secrets & local env files (Render injects env vars via the dashboard)
.env
.env.*
!.env.example

# Local dev data — never ship the developer's SQLite database
database/database.sqlite
database/*.sqlite*
storage/database/*.sqlite*
storage/logs/*.log
storage/framework/cache/data/*

# Build artifacts & caches
public/build
public/hot
public/storage
.phpunit.result.cache
.phpunit.cache
auth.json
npm-debug.log
yarn-error.log

# Logs
storage/logs/*.log
storage/pail